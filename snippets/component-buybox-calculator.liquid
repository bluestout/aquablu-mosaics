{%- comment -%}
  Buybox Calculator
  - <quantity-input-updated> wraps the quantity selector
  - <sqft-calculator> wraps the calculator box
  Both dispatch events bubbling up to <product-updated>.
{%- endcomment -%}

{%- assign current_variant = current_variant | default: product.selected_or_first_available_variant -%}
{%- assign sq_ft = sq_ft | default: 10.24 -%}

{%- comment -%}
  Grout / adhesive products use a DIFFERENT calculator from the sqft box.
  The sqft box turns square footage into tile boxes; the grout calculator
  (grout-calculator.liquid, rendered globally in theme.liquid) turns tile
  dimensions into pounds of grout & adhesive.
  Detected via product.template_suffix so it holds even when the page is
  previewed through ?view=updated-template (which changes template.suffix).
{%- endcomment -%}
{%- assign is_grout = false -%}
{%- if product.template_suffix == 'grout' -%}
  {%- assign is_grout = true -%}
{%- endif -%}
{%- if per -%}
  {%- assign unit_type = per | remove: 'per ' | downcase | strip -%}
{%- else -%}
  {%- assign unit_type = '' -%}
{%- endif -%}
{%- if unit_type == blank -%}
  {%- assign unit_noun = 'unit' -%}
  {%- assign units_required_label = 'Units Required' -%}
{%- elsif unit_type == 'each' -%}
  {%- assign unit_noun = 'unit' -%}
  {%- assign units_required_label = 'Units Required' -%}
{%- else -%}
  {%- assign unit_noun = unit_type -%}
  {%- assign unit_label = unit_type | capitalize -%}
  {%- assign units_required_label = unit_label | append: ' Required' -%}
{%- endif -%}

<div class="buybox-calculator">
  {%- comment -%} Quantity + How Much Link {%- endcomment -%}
  <div class="buybox-quantity-row">
    <quantity-input-updated class="buybox-quantity-group" data-min="1">
      <p class="buybox-quantity-label">Quantity: {% comment %} <strong>{{ unit_label }}</strong>{% endcomment %}</p>
      <div class="buybox-quantity-input">
        <button type="button" class="qty-decrease" aria-label="Decrease quantity">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="2" viewBox="0 0 10 2" fill="none">
            <line x1="0" y1="1" x2="10" y2="1" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
        <input
          type="number"
          class="qty-value"
          data-qty-value
          value="1"
          min="1"
          step="1"
          inputmode="numeric"
          aria-label="Quantity"
        >
        <button type="button" class="qty-increase" aria-label="Increase quantity">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
            <line x1="5" y1="0" x2="5" y2="10" stroke="currentColor" stroke-width="1.5"/>
            <line x1="0" y1="5" x2="10" y2="5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
    </quantity-input-updated>

    {%- comment -%}
      How-much link.
      - Grout products: opens the site-wide grout/adhesive modal via its
        #grout-form-modal-btn trigger (a distinct, tile-dimension calculator).
      - Sqft (full) mode: opens the inline <sqft-calculator> box below.
      - Simplified default products: no calculator.
    {%- endcomment -%}
    {%- if is_grout -%}
    <button type="button" id="grout-form-modal-btn" class="buybox-need-link buybox-need-link--grout">
      {%- render 'icon-buybox-calculator' -%}
      How much do I need?
    </button>
    {%- elsif simplified == false -%}
    <a href="#calculator" class="buybox-need-link">
      {%- render 'icon-buybox-calculator' -%}
      How much do I need?
    </a>
    {%- endif -%}
  </div>

  {%- comment -%}
    Sqft calculator box — only for full sqft mode. Never for grout (grout uses
    the modal above) or simplified default products.
  {%- endcomment -%}
  {%- if simplified == false and is_grout == false -%}
  <sqft-calculator class="buybox-calc-box" id="calculator" data-sqft-per-box="{{ sq_ft }}" data-unit-type="{{ unit_type }}">
    <div class="buybox-calc-header">
      <p class="buybox-calc-header-title">Calculate how much I need:</p>
      <button type="button" class="buybox-calc-toggle" aria-label="Toggle calculator">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
          <path d="M13.707 0.707092L0.707031 13.7071M13.7518 13.8653L0.751804 0.865294" stroke="black" stroke-width="2"/>
        </svg>
      </button>
    </div>

    <div class="buybox-calc-form">
      <input
        type="number"
        class="buybox-calc-input"
        placeholder="Enter square footage"
        data-calc-sqft
        min="0"
        step="any"
      >
      <input
        type="number"
        class="buybox-calc-input"
        placeholder="Or enter {{ unit_noun }} amount"
        data-calc-boxes
        min="0"
        step="any"
      >
      <button type="button" class="buybox-calc-btn">Calculate</button>
    </div>

    <div class="buybox-calc-divider"></div>

    {%- comment -%} Overage checkbox {%- endcomment -%}
    <div class="buybox-calc-overage">
      <input type="checkbox" class="buybox-calc-checkbox" id="overage-checkbox" data-calc-overage>
      <label class="buybox-calc-overage-label" for="overage-checkbox">
        Add 10% overage for cuts and waste <em>(recommended)</em>
      </label>
    </div>

    {%- comment -%} Calculation details {%- endcomment -%}
    <div class="buybox-calc-details">
      <div class="buybox-calc-row">
        <span class="buybox-calc-row-label">Subtotal</span>
        <span class="buybox-calc-row-value" data-calc-subtotal>0 sq. ft.</span>
      </div>
      <div class="buybox-calc-row">
        <span class="buybox-calc-row-label">Overage</span>
        <span class="buybox-calc-row-value" data-calc-overage-value>0 sq. ft.</span>
      </div>
      <div class="buybox-calc-row">
        <span class="buybox-calc-row-label">Total</span>
        <span class="buybox-calc-row-value" data-calc-total>0 sq. ft.</span>
      </div>
      <div class="buybox-calc-row">
        <span class="buybox-calc-row-label">{{ units_required_label }}</span>
        <span class="buybox-calc-row-value" data-calc-boxes-required>0 @ {{ sq_ft }} sq.ft./{{ unit_noun }}</span>
      </div>
      <div class="buybox-calc-row">
        <span class="buybox-calc-row-label">Square Feet Included</span>
        <span class="buybox-calc-row-value" data-calc-sqft-included>0 sq.ft.</span>
      </div>
    </div>
  </sqft-calculator>
  {%- endif -%}

  {%- comment -%} Total Price {%- endcomment -%}
  <div class="buybox-total">
    <hr class="buybox-total-divider">
    <div class="buybox-total-row">
      <span class="buybox-total-label">Total Price:</span>
      <span class="buybox-total-value" data-total-price>{{ current_variant.price | money }}</span>
    </div>
  </div>
</div>
