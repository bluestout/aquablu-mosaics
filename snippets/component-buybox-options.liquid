{%- comment -%}
  Buybox Options

  Color/Style swatches:
    Products pulled from the `products` field on the metaobject referenced by
    `product.metafields.custom.combine_listing`.
    The "View the Collection" link still uses `product.metafields.custom.collection_url`.
    Each swatch is an <a> tag pointing to the related product. The swatch matching the
    current product gets `.is-active`.

  Size tabs (and any other variant options):
    Driven by the current product's variants. Clicking emits a variant change to
    <product-updated>.
{%- endcomment -%}

{%- assign current_variant = current_variant | default: product.selected_or_first_available_variant -%}
{%- assign options_collection = product.metafields.custom.collection_url.value -%}
{%- assign combine_listing = product.metafields.custom.combine_listing.value -%}
{%- assign combine_products = combine_listing.products.value -%}

<div class="buybox-options">
  {%- comment -%} === Color / Style swatches from combine_listing metaobject === {%- endcomment -%}
  {%- if combine_products.size > 0 -%}
    {%- assign current_label = product.metafields.custom.color_name
      | default: product.metafields.custom.option_label
      | default: product.title
    -%}

    <div class="buybox-option-group">
      <div class="buybox-option-header">
        <p class="buybox-option-label">
          Options: <strong>{{ current_label }}</strong>
        </p>
        {%- if options_collection.url -%}
          <a href="{{ options_collection.url }}" class="buybox-view-collection">
            View the Collection
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="12" viewBox="0 0 13 12" fill="none">
              <path d="M0 5.85355H11" stroke="black"/>
              <path d="M6 0.353546L11.5 5.85355L6 10.8535" stroke="black"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
      {%- assign swatch_visible_limit = 10 -%}
      {%- comment -%} Auto-expand if the active product is past the visible limit, so it stays visible. {%- endcomment -%}
      {%- assign auto_expand_swatches = false -%}
      {%- for option_product in combine_products -%}
        {%- if option_product.id == product.id and forloop.index > swatch_visible_limit -%}
          {%- assign auto_expand_swatches = true -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="buybox-color-swatches{% if auto_expand_swatches %} is-expanded{% endif %}">
        {%- for option_product in combine_products -%}
          {%- assign is_current = false -%}
          {%- if option_product.id == product.id -%}{%- assign is_current = true -%}{%- endif -%}

          <a
            href="{{ option_product.url }}?view=updated-template"
            class="buybox-color-swatch{% if is_current %} is-active{% endif %}{% if forloop.index > swatch_visible_limit %} buybox-color-swatch--hidden{% endif %}"
            aria-label="{{ option_product.title | escape }}"
            title="{{ option_product.title | escape }}"
            {% if is_current %}
              aria-current="page"
            {% endif %}
          >
            {%- if option_product.featured_image -%}
              <img
                src="{{ option_product.featured_image | image_url: width: 120 }}"
                alt="{{ option_product.title | escape }}"
                width="60"
                height="60"
                loading="lazy"
              >
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>

      {%- if combine_products.size > swatch_visible_limit and auto_expand_swatches == false -%}
        <button type="button" class="buybox-swatches-show-more" data-show-more-swatches>
          <span data-more-text>Show More ({{ combine_products.size | minus: swatch_visible_limit }})</span>
          <span data-less-text hidden>Show less</span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} === Variant-based options (Size, etc.) === {%- endcomment -%}
  {%- for option in product.options_with_values -%}
    {%- assign option_index = forloop.index0 -%}
    {%- assign selected_value = current_variant.options[option_index] -%}

    {%- comment -%} Skip Color/Colour — handled by collection metafield above {%- endcomment -%}
    {%- unless option.name == 'Color' or option.name == 'Colour' -%}

      {%- comment -%} Count non-sample values — hide the selector if only 1 exists {%- endcomment -%}
      {%- assign non_sample_count = 0 -%}
      {%- for value in option.values -%}
        {%- assign value_lower = value | downcase -%}
        {%- unless value_lower contains 'sample' -%}
          {%- assign non_sample_count = non_sample_count | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}

      {%- if non_sample_count > 1 -%}
        <div class="buybox-option-group buybox-option-group--size">
          <p class="buybox-option-label">
            {{ option.name }}: <strong>{{ selected_value }}</strong>
          </p>
          <div class="buybox-size-options">
            {%- for value in option.values -%}
              {%- assign value_lower = value | downcase -%}
              {%- unless value_lower contains 'sample' -%}
                <button
                  type="button"
                  class="buybox-size-option{% if value == selected_value %} is-active{% endif %}"
                  data-option-index="{{ option_index }}"
                  data-value="{{ value | escape }}"
                >
                  {{ value }}
                </button>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    {%- endunless -%}
  {%- endfor -%}

  {%- comment -%} Options divider {%- endcomment -%}
  <hr class="buybox-options-divider">
</div>
