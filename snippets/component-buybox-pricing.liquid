{%- comment -%}
  Buybox Pricing
  Displays: price per sq ft, price per box, sold-by label, shipping text, sample button.

  Sample button:
    - Only renders when `sample_variant` is provided.
    - Uses the sample variant's price and ID.
    - Click is handled by <product-updated> which adds sample_variant to cart.

  @param modal - true inside the Quick Shop modal, which drops the "Visualize
                 in Your Space" trigger (that opens a second modal).
  @param show_visualizer - section setting; gates the mobile "Visualize in Your
                 Space" trigger the same way it gates the desktop one.
  @param display_price - what the customer pays: sale price less any AquaPro
                 discount (cents). Falls back to the variant price.
  @param compare_price - retail / compare-at price struck through beside it
                 when higher than display_price (cents).
{%- endcomment -%}

{%- assign current_variant = current_variant | default: product.selected_or_first_available_variant -%}
{%- assign sq_ft = sq_ft | default: 10.24 -%}
{%- assign sq_ft_label = sq_ft_label | default: sq_ft -%}
{%- if per -%}
  {%- assign unit_type = per | remove: 'per ' | downcase | strip -%}
{%- else -%}
  {%- assign unit_type = '' -%}
{%- endif -%}
{%- comment -%} Each-sold products read "$45.00 each" with no sold-by line {%- endcomment -%}
{%- if unit_type == 'each' -%}
  {%- assign per = 'each' -%}
{%- endif -%}
{%- assign display_price = display_price | default: current_variant.price -%}
{%- assign compare_price = compare_price | default: display_price -%}
{%- assign show_compare = false -%}
{%- if compare_price > display_price -%}
  {%- assign show_compare = true -%}
{%- endif -%}
{%- assign price_per_sqft_cents = display_price | divided_by: sq_ft -%}
{%- assign compare_per_sqft_cents = compare_price | divided_by: sq_ft -%}

{%- comment -%} Split the sample price into dollars + cents for the superscript styling {%- endcomment -%}
{%- if sample_variant -%}
  {%- assign sample_dollars = sample_variant.price | divided_by: 100 -%}
  {%- assign sample_cents_int = sample_variant.price | modulo: 100 -%}
  {%- if sample_cents_int < 10 -%}
    {%- assign sample_cents = '0' | append: sample_cents_int -%}
  {%- else -%}
    {%- assign sample_cents = sample_cents_int | append: '' -%}
  {%- endif -%}
{%- endif -%}

<div class="buybox-pricing">
  {%- comment -%} Price per sq ft — hidden in simplified mode (default / grout) {%- endcomment -%}
  {%- unless simplified -%}
    <p class="buybox-price-sqft{% if show_compare %} is-discounted{% endif %}" data-price-wrap>
      <span class="buybox-price-current" data-price-sqft>{{ price_per_sqft_cents | money }}</span> per sq. ft.
      <s class="buybox-price-compare" data-compare-sqft{% unless show_compare %} hidden{% endunless %}>
        <span class="visually-hidden">Regular price</span>
        {{ compare_per_sqft_cents | money }}
      </s>
    </p>
  {%- endunless -%}

  {%- comment -%} Price per box row {%- endcomment -%}
  <div class="buybox-price-row">
    <div class="buybox-price-box-info">
      <span class="buybox-price-box{% if show_compare %} is-discounted{% endif %}" data-price-wrap>
        <span class="buybox-price-current" data-price-box>{{ display_price | money }}</span>{% if per %} {{ per }}{% endif %}
        <s class="buybox-price-compare" data-compare-box{% unless show_compare %} hidden{% endunless %}>
          <span class="visually-hidden">Regular price</span>
          {{ compare_price | money }}
        </s>
      </span>
      {%- if unit_type != blank and unit_type != 'each' -%}
        <span class="buybox-sold-by-label">
          Sold by {{ unit_type }}{% unless simplified %} ({{ sq_ft_label }} sq.ft.){% endunless %}
        </span>
      {%- endif -%}
    </div>

    <span class="buybox-shipping-text up-mobile-only" data-shipping-slot>
      {%- render 'component-buybox-shipping', current_variant: current_variant, shipping_window: shipping_window -%}
    </span>

    {%- comment -%}
      Mobile visualizer trigger. Desktop keeps its copy under the media
      gallery, which is a different column — on mobile that column is pushed
      below the buybox, so the button is repeated here, above order-a-sample.
    {%- endcomment -%}
    {%- if show_visualizer and modal != true -%}
      {%- render 'component-visualize-btn', product: product, device: 'mobile' -%}
    {%- endif -%}

    {%- comment -%} Order-a-sample — hidden in simplified mode (default / grout) {%- endcomment -%}
    {%- if sample_variant and simplified != true -%}
      <button
        type="button"
        class="buybox-sample-btn"
        data-sample-btn
        data-sample-variant-id="{{ sample_variant.id }}"
        {% unless sample_variant.available %}disabled{% endunless %}
      >
        <span data-sample-label>
          Order a sample for ${{ sample_dollars }}<span class="price-cents">{{ sample_cents }}</span>
        </span>
      </button>
    {%- endif -%}
  </div>

  {%- comment -%} Shipping badge — matches live "This item ships FREE!" logic {%- endcomment -%}
  <span class="buybox-shipping-text up-desktop-only" data-shipping-slot>
    {%- render 'component-buybox-shipping', current_variant: current_variant, shipping_window: shipping_window -%}
  </span>

  {%- comment -%} Divider {%- endcomment -%}
  <hr class="buybox-divider">
</div>
