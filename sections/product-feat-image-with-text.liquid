{%- liquid
  assign body_content = section.settings.body_text
  assign heading_text = section.settings.heading

  if section.settings.use_product_description and product.description != blank
    assign body_content = product.description

    comment
      Pull the first heading (h1, else h2) out of the description so it can
      render in pfiwt__heading, and strip that heading tag from the body.
    endcomment
    assign extracted_heading = ''
    assign heading_tag = ''
    assign heading_levels = 'h1,h2' | split: ','
    for level in heading_levels
      assign open_tag = '<' | append: level
      if body_content contains open_tag
        assign heading_tag = level
        break
      endif
    endfor

    if heading_tag != ''
      assign close_tag = '</' | append: heading_tag | append: '>'
      assign open_tag = '<' | append: heading_tag
      assign after_open = body_content | split: open_tag | last
      assign inner_with_attrs = after_open | split: close_tag | first
      comment
        inner_with_attrs still starts with the opening tag's remainder
        (attributes + '>'). Remove everything up to and including that first '>',
        then strip any nested tags (e.g. <strong>) from the heading text.
      endcomment
      assign open_remainder = inner_with_attrs | split: '>' | first | append: '>'
      assign extracted_heading = inner_with_attrs | remove_first: open_remainder | strip_html | strip

      assign before_heading = body_content | split: open_tag | first
      assign after_heading = body_content | split: close_tag | last
      assign body_content = before_heading | append: after_heading
    endif

    if extracted_heading != ''
      assign heading_text = extracted_heading
    else
      assign heading_text = ''
    endif
  endif
-%}
{%- if section.settings.image != blank or heading_text != blank or body_content != blank -%}
  <style>
    /* ===== Product Feature: Image with Text ===== */
    .pfiwt {
      padding-top: 60px;
      padding-bottom: 60px;
      background-color: #fff;
    }

    .pfiwt__inner {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 40px;
    }

    .pfiwt__inner--image-right {
      flex-direction: row-reverse;
    }

    .pfiwt__inner--no-image {
      justify-content: center;
      text-align: center;
    }

    .pfiwt__inner--no-image .pfiwt__text-col {
      align-items: center;
    }

    .pfiwt__image-col {
      flex: 0 0 auto;
      width: 50%;
    }

    .pfiwt__image-wrapper {
      position: relative;
      width: 100%;
      overflow: hidden;
    }

    .pfiwt__image-wrapper img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .pfiwt__text-col {
      flex: 1 1 0;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .pfiwt__heading {
      font-size: 20px;
      font-weight: 700;
      line-height: 28px;
      letter-spacing: 0.9px;
      text-transform: uppercase;
      color: #000;
      margin: 0;
    }

    .pfiwt__body {
      font-size: 16px;
      font-weight: 300;
      line-height: 24px;
      color: #000;
    }

    .pfiwt__body p {
      margin: 0 0 16px;
    }

    .pfiwt__body p:last-child {
      margin-bottom: 0;
    }

    .pfiwt__body a {
      color: #000;
      text-decoration: underline;
      text-decoration-skip-ink: none;
    }

    .pfiwt__body a:hover {
      opacity: 0.75;
    }

    .pfiwt__body em,
    .pfiwt__body i {
      font-style: italic;
    }

    .pfiwt__body ul li {
      width: fit-content;
    }

    .pfiwt__body ul {
      max-width: max-content;
      margin: 0 auto;
    }

    @media (max-width: 768px) {
      .pfiwt {
        padding-top: 40px;
        padding-bottom: 40px;
      }

      .product-feat-image-text{
        margin-top: 0px;
      }

      .pfiwt__inner,
      .pfiwt__inner--image-right {
        flex-direction: column;
        gap: 24px;
      }

      .pfiwt__image-col {
        width: 100%;
      }

      .pfiwt__text-col {
        gap: 16px;
      }
    }

    @media (max-width: 1024px) {
      .pfiwt__inner {
        align-items: flex-start;
      }
    }
  </style>

  <div class="pfiwt product-feat-image-text" id="ProductFeatImageWithText-{{ section.id }}">
    <div class="page-width">
      <div class="pfiwt__inner{% if section.settings.image_position == 'right' %} pfiwt__inner--image-right{% endif %}{% if section.settings.image == blank %} pfiwt__inner--no-image{% endif %}">
        {%- if section.settings.image != blank -%}
          <div class="pfiwt__image-col">
            <div class="pfiwt__image-wrapper">
              {{
                section.settings.image
                | image_url: width: 1260
                | image_tag: loading: 'lazy', alt: section.settings.image.alt
                | default: section.settings.heading, widths: '400, 600, 800, 1000, 1260'
              }}
            </div>
          </div>
        {%- endif -%}

        <div class="pfiwt__text-col">
          {%- if heading_text != blank -%}
            <h2 class="pfiwt__heading">{{ heading_text | escape }}</h2>
          {%- endif -%}

          {%- if body_content != blank -%}
            <div class="pfiwt__body rte">
              {{ body_content }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PORCELAIN DECO TILE FOR POOLS"
    },
    {
      "type": "checkbox",
      "id": "use_product_description",
      "label": "Use product description as body text",
      "info": "When enabled, the product's description is shown here instead of the body text below.",
      "default": true
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "info": "Used only when 'Use product description as body text' is off.",
      "default": "<p>Add your product description here. You can include <a href=\"#\">inline links</a> and use italic text for disclaimers.</p>"
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
