{{ 'component-product-updated.css' | asset_url | stylesheet_tag }}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- comment -%}
  Simplified mode strips the sqft-only features (per-sqft price, per-unit sq.ft.
  label, order-a-sample, how-much calculator) for the default & grout templates.

  The mode is resolved from `product.template_suffix` by default rather than the
  section setting alone, so it stays correct when a product is previewed through
  `?view=updated-template` (which swaps the template JSON — and therefore the
  section settings — out from under the product). The setting can still force a
  mode when needed.
{%- endcomment -%}
{%- assign is_grout = false -%}
{%- if product.template_suffix == 'grout' -%}
  {%- assign is_grout = true -%}
{%- endif -%}

{%- assign resolved_mode = section.settings.template_mode | default: 'auto' -%}
{%- if resolved_mode == 'auto' -%}
  {%- if product.template_suffix == 'sqft' -%}
    {%- assign resolved_mode = 'sqft' -%}
  {%- else -%}
    {%- assign resolved_mode = 'simplified' -%}
  {%- endif -%}
{%- endif -%}

{%- assign simplified = false -%}
{%- if resolved_mode == 'simplified' -%}
  {%- assign simplified = true -%}
{%- endif -%}

{%- comment -%}
  The how-much calculator can be shown independently of simplified mode.
  In full sqft mode it always shows; grout products always get their own
  (tile-dimension) calculator; other simplified products only get one when
  `show_calculator` is enabled.
{%- endcomment -%}
{%- assign hide_calculator = simplified -%}
{%- if section.settings.show_calculator or is_grout -%}
  {%- assign hide_calculator = false -%}
{%- endif -%}

{%- comment -%}
  Shipping window for "Usually ships in <window>".
  Resolution order (most specific wins):
    3. Section setting     "Default shipping window"
    2. Parsed fallback     custom.tab_shipping — legacy behaviour, kept so
                           products without the metafield keep working.
    1. Product metafield   custom.ship_window — the authoritative value.

  `shipping_window` always ends up as a COMPLETE phrase including its unit
  ("3-5 business days", "2-3 weeks"), so the snippet prints it verbatim. That
  is what lets a weeks-based lead time render correctly, which the old
  digits-only value could not do.
{%- endcomment -%}
{%- assign shipping_window = section.settings.default_shipping_window | default: '3-5 business days' -%}

{%- comment -%}
  Fallback: pull the "3-5" out of "... within 3-5 business days. ..." — the
  token immediately before "business days". This is unreliable by nature: it
  takes the FIRST "business days" in the copy, which on some vendors is the
  transit time or the sample lead time rather than the ship window, and copy
  worded in weeks yields nothing. It is a safety net only — set
  custom.ship_window on the product to bypass it entirely.
{%- endcomment -%}
{%- assign tab_shipping = product.metafields.custom.tab_shipping.value -%}
{%- if tab_shipping contains 'business days' -%}
  {%- comment -%} Normalise "2 - 4" / "2- 4" / "2 -4" to "2-4" first {%- endcomment -%}
  {%- assign lead_in = tab_shipping
    | split: 'business days'
    | first
    | replace: ' - ', '-'
    | replace: '- ', '-'
    | replace: ' -', '-'
    | strip
  -%}
  {%- assign candidate = lead_in | split: ' ' | last | strip -%}

  {%- assign candidate_chars = candidate | split: '' -%}
  {%- assign candidate_is_range = true -%}
  {%- assign candidate_has_digit = false -%}
  {%- if candidate_chars.size == 0 -%}
    {%- assign candidate_is_range = false -%}
  {%- endif -%}
  {%- for ch in candidate_chars -%}
    {%- unless '0123456789-' contains ch -%}
      {%- assign candidate_is_range = false -%}
    {%- endunless -%}
    {%- if '0123456789' contains ch -%}
      {%- assign candidate_has_digit = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if candidate_is_range and candidate_has_digit -%}
    {%- assign shipping_window = candidate | append: ' business days' -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Authoritative override. A complete phrase such as "2-3 weeks" or
  "1-3 business days" — printed exactly as entered, no parsing.
{%- endcomment -%}
{%- assign ship_window_field = product.metafields.custom.ship_window.value | strip -%}
{%- if ship_window_field != blank -%}
  {%- assign shipping_window = ship_window_field -%}
{%- endif -%}

{%- comment -%}
  Sqft template only: a product with a single real size has nothing to choose
  between, so the size row is dropped entirely. Default/grout keep it as a
  static spec line.
{%- endcomment -%}
{%- assign hide_single_size = false -%}
{%- if resolved_mode == 'sqft' -%}
  {%- assign hide_single_size = true -%}
{%- endif -%}

{%- comment -%} Parse sq_ft and per from product tags (old implementation) {%- endcomment -%}
{%- assign sq_ft = false -%}
{%- assign per = false -%}
{%- for tag in product.tags -%}
  {%- if tag contains 'coverage:' -%}
    {%- assign sq_ft = tag | remove: 'coverage:' | remove: ' Sqft' | remove: ' sqft' | times: 1.00 -%}
  {%- endif -%}
  {%- if tag contains 'sold by:' -%}
    {%- assign per = tag | remove: 'sold by:' | prepend: 'per ' -%}
  {%- endif -%}
  {%- if product.type == 'Pool Mosaic' -%}
    {%- assign per = 'each' -%}
  {%- endif -%}
{%- endfor -%}
{%- unless sq_ft -%}{%- assign sq_ft = 10.24 -%}{%- endunless -%}
{%- if per -%}
  {%- assign unit_type = per | remove: 'per ' | downcase | strip -%}
{%- else -%}
  {%- assign unit_type = '' -%}
{%- endif -%}

{%- assign sample_variant = nil -%}
{%- for v in product.variants -%}
  {%- assign v_title_lower = v.title | downcase -%}
  {%- if v_title_lower contains 'sample' -%}
    {%- assign sample_variant = v -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%}
  Variant IDs eligible for the "This item ships FREE!" badge, using the live
  site's rule (price > $299 and weight_in_unit < 120). weight_in_unit is a
  Liquid-only field, so we precompute the eligible set here for the JS toggle.
{%- endcomment -%}
{%- assign ships_free_variants = '' -%}
{%- for v in product.variants -%}
  {%- if v.price > 29900 and v.weight_in_unit < 120 -%}
    {%- assign ships_free_variants = ships_free_variants | append: v.id | append: ',' -%}
  {%- endif -%}
{%- endfor -%}

<product-updated
  class="product-updated-main-wrapper"
  id="updated-product-{{ section.id }}"
  data-current-variant-id="{{ current_variant.id }}"
  data-sqft-per-box="{{ sq_ft }}"
  data-unit-type="{{ unit_type }}"
  data-ships-free-variants="{{ ships_free_variants }}"
>
  {%- comment -%} Inject product JSON for variant lookup {%- endcomment -%}
  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>

  <div class="product-updated-child-wrapper page-width">
    <div class="up-media-wrapper">
      {% render 'component-product-media', product: product %}
    </div>
    <div class="up-product-info-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'header' -%}
            {% render 'component-buybox-header', product: product, current_variant: current_variant %}
          {%- when 'pricing' -%}
            {% render 'component-buybox-pricing',
              product: product,
              current_variant: current_variant,
              sq_ft: sq_ft,
              per: per,
              sample_variant: sample_variant,
              simplified: simplified,
              shipping_window: shipping_window
            %}
          {%- when 'options' -%}
            {% render 'component-buybox-options',
              product: product,
              current_variant: current_variant,
              sample_variant: sample_variant,
              hide_single_size: hide_single_size,
              swatch_visible_limit: section.settings.swatch_visible_limit
            %}
          {%- when 'calculator' -%}
            {% render 'component-buybox-calculator',
              product: product,
              current_variant: current_variant,
              sq_ft: sq_ft,
              per: per,
              simplified: hide_calculator
            %}
          {%- when 'cta' -%}
            {% render 'component-buybox-cta',
              product: product,
              current_variant: current_variant,
              simplified: simplified
            %}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</product-updated>

{%- comment -%} Request Custom Quote — available on all three product templates {%- endcomment -%}
{% render 'component-quote-popup', product: product, current_variant: current_variant %}

<script src="{{ 'component-product-updated.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main Product Updated",
  "settings": [
    {
      "type": "select",
      "id": "template_mode",
      "label": "Template mode",
      "info": "Auto reads the product's own template suffix (sqft / grout / default) and stays correct in ?view= previews. Only force a mode to override that.",
      "options": [
        { "value": "auto", "label": "Auto (from product template)" },
        { "value": "sqft", "label": "Sqft (full)" },
        { "value": "simplified", "label": "Simplified (default / grout)" }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "show_calculator",
      "label": "Show how-much calculator",
      "info": "In Simplified mode, show the 'How much do I need?' calculator while keeping per-sq-ft price and order-a-sample hidden. Grout products always get their own calculator.",
      "default": false
    },
    {
      "type": "range",
      "id": "swatch_visible_limit",
      "label": "Combined listing swatches shown",
      "info": "How many swatches render before the 'Show More' toggle. The swatch for the product being viewed is always shown, taking one of these slots when it falls past the limit, so the collapsed grid is this size on every product.",
      "min": 4,
      "max": 40,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "default_shipping_window",
      "label": "Default shipping window",
      "info": "Fallback for 'Usually ships in ...'. Include the unit, e.g. '3-5 business days' or '2-3 weeks'. Overridden per product by the custom.ship_window metafield, then by the range parsed out of custom.tab_shipping.",
      "default": "3-5 business days"
    }
  ],
  "blocks": [
    {
      "type": "header",
      "name": "Header"
    },
    {
      "type": "pricing",
      "name": "Pricing"
    },
    {
      "type": "options",
      "name": "Options"
    },
    {
      "type": "calculator",
      "name": "Calculator"
    },
    {
      "type": "cta",
      "name": "CTA Buttons"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Main Product Updated",
      "blocks": [
        { "type": "header" },
        { "type": "pricing" },
        { "type": "options" },
        { "type": "calculator" },
        { "type": "cta" }
      ]
    }
  ]
}
{% endschema %}
