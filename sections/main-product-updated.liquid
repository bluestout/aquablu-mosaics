{{ 'component-product-updated.css' | asset_url | stylesheet_tag }}

{%- assign is_quick_shop = false -%}
{%- if template.suffix == 'modal' -%}
  {%- assign is_quick_shop = true -%}
  {{ 'component-product-quick-shop.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign is_grout = false -%}
{%- if product.template_suffix == 'grout' -%}
  {%- assign is_grout = true -%}
{%- endif -%}

{%- assign resolved_mode = section.settings.template_mode | default: 'auto' -%}
{%- if resolved_mode == 'auto' -%}
  {%- if product.template_suffix == 'sqft' -%}
    {%- assign resolved_mode = 'sqft' -%}
  {%- else -%}
    {%- assign resolved_mode = 'simplified' -%}
  {%- endif -%}
{%- endif -%}

{%- assign simplified = false -%}
{%- if resolved_mode == 'simplified' -%}
  {%- assign simplified = true -%}
{%- endif -%}

{%- assign hide_calculator = simplified -%}
{%- if section.settings.show_calculator or is_grout -%}
  {%- assign hide_calculator = false -%}
{%- endif -%}

{%- comment -%}
  "Visualize in Your Space" is off by default and comes back from the theme
  editor rather than a code change. The TilesView markup and its metafield gate
  are untouched underneath, so flipping the setting restores both the desktop
  trigger under the gallery and the mobile one above Order a Sample.
{%- endcomment -%}
{%- assign show_visualizer = section.settings.show_visualizer -%}

{%- comment -%}
  Shipping window for "Usually ships in <window>."

  Priority: custom.ship_window metafield (an exact, complete phrase) → the first
  duration range found in custom.tab_shipping → the section default.

  tab_shipping copy is written per product and uses several units, e.g.
    "...orders ship within 2-3 weeks."
    "...product ships within an estimated 14-16 weeks."
    "...usually ships in 3-5 business days."
    "Item ships from Florida, USA within 1-2 weeks. ... Average transit time
     3-6 business days to most states."
  so we take the FIRST duration in the copy — that is the lead time — and keep
  whatever unit it was written in. In the last example above that gives
  "1-2 weeks", not the "3-6 business days" transit estimate that follows it.
{%- endcomment -%}

{%- assign shipping_window = section.settings.default_shipping_window | default: '3-5 business days' -%}

{%- assign newline = '
' -%}
{%- capture tab_shipping_raw -%}{{ product.metafields.custom.tab_shipping.value }}{%- endcapture -%}
{%- assign tab_shipping = tab_shipping_raw
  | strip_html
  | downcase
  | replace: newline, ' '
  | replace: '&nbsp;', ' '
  | replace: '&ndash;', '-'
  | replace: '–', '-'
  | replace: '—', '-'
  | replace: ' - ', '-'
  | replace: '- ', '-'
  | replace: ' -', '-'
-%}

{%- comment -%}
  Most specific unit first so "business days" wins over the "days" inside it and
  "weeks" wins over "week"; ties keep the earlier entry.
{%- endcomment -%}
{%- assign ship_units = 'business days,business day,weeks,week,days,day' | split: ',' -%}
{%- assign matched_unit = '' -%}
{%- assign matched_lead_in = '' -%}
{%- assign matched_at = 999999 -%}

{%- for unit in ship_units -%}
  {%- if tab_shipping contains unit -%}
    {%- assign lead_in = tab_shipping | split: unit | first -%}
    {%- assign unit_at = lead_in.size -%}
    {%- if unit_at < matched_at -%}
      {%- assign matched_at = unit_at -%}
      {%- assign matched_unit = unit -%}
      {%- assign matched_lead_in = lead_in -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if matched_unit != '' -%}
  {%- assign candidate = matched_lead_in | strip | split: ' ' | last | strip -%}

  {%- assign candidate_chars = candidate | split: '' -%}
  {%- assign candidate_is_range = true -%}
  {%- assign candidate_has_digit = false -%}
  {%- if candidate_chars.size == 0 -%}
    {%- assign candidate_is_range = false -%}
  {%- endif -%}
  {%- for ch in candidate_chars -%}
    {%- unless '0123456789-' contains ch -%}
      {%- assign candidate_is_range = false -%}
    {%- endunless -%}
    {%- if '0123456789' contains ch -%}
      {%- assign candidate_has_digit = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if candidate_is_range and candidate_has_digit -%}
    {%- assign shipping_window = candidate | append: ' ' | append: matched_unit -%}
  {%- endif -%}
{%- endif -%}

{%- assign ship_window_field = product.metafields.custom.ship_window.value | strip -%}
{%- if ship_window_field != blank -%}
  {%- assign shipping_window = ship_window_field -%}
{%- endif -%}

{%- assign hide_single_size = false -%}
{%- if resolved_mode == 'sqft' -%}
  {%- assign hide_single_size = true -%}
{%- endif -%}

{%- assign sq_ft = false -%}
{%- assign per = false -%}
{%- for tag in product.tags -%}
  {%- if tag contains 'coverage:' -%}
    {%- assign sq_ft = tag | remove: 'coverage:' | remove: ' Sqft' | remove: ' sqft' | times: 1.00 -%}
  {%- endif -%}
  {%- if tag contains 'sold by:' -%}
    {%- assign per = tag | remove: 'sold by:' | prepend: 'per ' -%}
  {%- endif -%}
  {%- if product.type == 'Pool Mosaic' -%}
    {%- assign per = 'each' -%}
  {%- endif -%}
{%- endfor -%}
{%- unless sq_ft -%}{%- assign sq_ft = 10.24 -%}{%- endunless -%}
{%- if per -%}
  {%- assign unit_type = per | remove: 'per ' | downcase | strip -%}
{%- else -%}
  {%- assign unit_type = '' -%}
{%- endif -%}

{%- assign sample_variant = nil -%}
{%- for v in product.variants -%}
  {%- assign v_title_lower = v.title | downcase -%}
  {%- if v_title_lower contains 'sample' -%}
    {%- assign sample_variant = v -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign ships_free_variants = '' -%}
{%- for v in product.variants -%}
  {%- if v.price > 29900 and v.weight_in_unit < 120 -%}
    {%- assign ships_free_variants = ships_free_variants | append: v.id | append: ',' -%}
  {%- endif -%}
{%- endfor -%}

<product-updated
  class="product-updated-main-wrapper{% if is_quick_shop %} quick-shop-product{% endif %}"
  id="updated-product-{{ section.id }}{% if is_quick_shop %}-{{ product.id }}{% endif %}"
  data-product-handle="{{ product.handle }}"
  data-product-id="{{ product.id }}"
  data-current-variant-id="{{ current_variant.id }}"
  data-sqft-per-box="{{ sq_ft }}"
  data-unit-type="{{ unit_type }}"
  data-ships-free-variants="{{ ships_free_variants }}"
  {% if is_quick_shop %}data-in-modal{% endif %}
>
  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>

  <div class="product-updated-child-wrapper page-width">
    <div class="up-media-wrapper">
      {% render 'component-product-media',
        product: product,
        modal: is_quick_shop,
        show_visualizer: show_visualizer
      %}
    </div>
    <div class="up-product-info-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'header' -%}
            {% render 'component-buybox-header',
              product: product,
              current_variant: current_variant,
              modal: is_quick_shop
            %}
          {%- when 'pricing' -%}
            {% render 'component-buybox-pricing',
              product: product,
              current_variant: current_variant,
              sq_ft: sq_ft,
              per: per,
              sample_variant: sample_variant,
              simplified: simplified,
              shipping_window: shipping_window,
              modal: is_quick_shop,
              show_visualizer: show_visualizer
            %}
          {%- when 'options' -%}
            {% render 'component-buybox-options',
              product: product,
              current_variant: current_variant,
              sample_variant: sample_variant,
              hide_single_size: hide_single_size,
              swatch_visible_limit: section.settings.swatch_visible_limit,
              modal: is_quick_shop
            %}
          {%- when 'calculator' -%}
            {% render 'component-buybox-calculator',
              product: product,
              current_variant: current_variant,
              sq_ft: sq_ft,
              per: per,
              simplified: hide_calculator,
              modal: is_quick_shop
            %}
          {%- when 'cta' -%}
            {% render 'component-buybox-cta',
              product: product,
              current_variant: current_variant,
              simplified: simplified,
              modal: is_quick_shop
            %}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</product-updated>

{%- unless is_quick_shop -%}
  {% render 'component-quote-popup', product: product, current_variant: current_variant %}
{%- endunless -%}

<script src="{{ 'component-product-updated.js' | asset_url }}" defer></script>
{%- if is_quick_shop -%}
  <script src="{{ 'photoswipe_ori.min.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Main Product Updated",
  "settings": [
    {
      "type": "select",
      "id": "template_mode",
      "label": "Template mode",
      "info": "Auto reads the product's own template suffix (sqft / grout / default) and stays correct in ?view= previews. Only force a mode to override that.",
      "options": [
        { "value": "auto", "label": "Auto (from product template)" },
        { "value": "sqft", "label": "Sqft (full)" },
        { "value": "simplified", "label": "Simplified (default / grout)" }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "show_calculator",
      "label": "Show how-much calculator",
      "info": "In Simplified mode, show the 'How much do I need?' calculator while keeping per-sq-ft price and order-a-sample hidden. Grout products always get their own calculator.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_visualizer",
      "label": "Show \"Visualize in Your Space\"",
      "info": "Off hides the TilesView trigger on both desktop and mobile. When on, it still only appears on products that carry a TilesView product id.",
      "default": false
    },
    {
      "type": "range",
      "id": "swatch_visible_limit",
      "label": "Combined listing swatches shown",
      "info": "How many swatches render before the 'Show More' toggle. The swatch for the product being viewed is always shown, taking one of these slots when it falls past the limit, so the collapsed grid is this size on every product.",
      "min": 4,
      "max": 40,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "default_shipping_window",
      "label": "Default shipping window",
      "info": "Fallback for 'Usually ships in ...'. Include the unit, e.g. '3-5 business days' or '2-3 weeks'. Used only when nothing can be read from the product: the first duration in custom.tab_shipping (days or weeks) wins over this, and custom.ship_window wins over both.",
      "default": "3-5 business days"
    }
  ],
  "blocks": [
    {
      "type": "header",
      "name": "Header"
    },
    {
      "type": "pricing",
      "name": "Pricing"
    },
    {
      "type": "options",
      "name": "Options"
    },
    {
      "type": "calculator",
      "name": "Calculator"
    },
    {
      "type": "cta",
      "name": "CTA Buttons"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Main Product Updated",
      "blocks": [
        { "type": "header" },
        { "type": "pricing" },
        { "type": "options" },
        { "type": "calculator" },
        { "type": "cta" }
      ]
    }
  ]
}
{% endschema %}
